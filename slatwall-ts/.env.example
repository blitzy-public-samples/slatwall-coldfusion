# ---------------------------------------------------------------------------
# slatwall-ts environment contract
#
# Derived from the legacy configuration it replaces:
#   config/configApplication.cfm  -> this.datasource.name = "Slatwall"
#   config/configORM.cfm          -> cfdbinfo DATABASE_PRODUCTNAME dialect probe
#
# This file documents the contract only. It contains NO credentials and MUST
# NOT contain any. Copy it to `.env` for local/test runs (`.env` is git-ignored);
# AWS Lambda injects these variables natively in deployed environments.
# ---------------------------------------------------------------------------

# --- MySQL connection to the existing Sw* schema (read and write, unchanged) --
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Slatwall
DB_USER=
DB_PASSWORD=

# --- Dialect -----------------------------------------------------------------
# config/configORM.cfm probed the server product name and mapped it to a
# Hibernate dialect:
#   product name contains "MySQL"     -> MySQL
#   product name contains "Microsoft" -> MicrosoftSQLServer
#   product name contains "Oracle"    -> Oracle10g
# slatwall-ts resolves this explicitly instead of probing, and targets the
# MySQL branch only.
DB_DIALECT=MySQL

# --- Connection pool (module-scope pool, reused across warm invocations) ------
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
