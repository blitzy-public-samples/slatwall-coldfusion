# slatwall-ts environment configuration (template — copy to .env for local work).
#
# Every value is read through src/config/env.ts; nothing below the config layer reads
# process.env directly, and no credential is ever hardcoded (AAP 0.8.3.9).
#
# Provenance of these names:
#   * DB_NAME default "Slatwall" comes from config/configApplication.cfm:L2
#     (`this.datasource.name = "Slatwall"`). The legacy application resolves the whole
#     connection from a CF/Railo datasource of that name, so no host, port or credential
#     is recorded anywhere in the legacy source — those four values are new here.
#   * The dialect is fixed to MySQL. config/configORM.cfm:L8-L14 probes the server with
#     cfdbinfo at runtime and picks MySQL / MicrosoftSQLServer / Oracle10g; the port
#     targets the MySQL branch only, and that collapse is a documented decision
#     (AAP 0.4.1.3), not an omission.
#   * DB_CONNECTION_LIMIT defaults to 1 because the pool is created at module scope for
#     reuse across warm Lambda invocations (AAP 0.3.2, 0.4.1.3). The legacy application
#     delegates pooling to the CF/Railo server and pins nothing in source.

NODE_ENV=development

# --- MySQL (existing Sw* schema; this service neither creates nor migrates it) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Slatwall
DB_USER=slatwall
DB_PASSWORD=
DB_CONNECTION_LIMIT=1
DB_CONNECT_TIMEOUT_MS=10000
