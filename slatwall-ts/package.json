{
  "name": "slatwall-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript port of the Slatwall catalog and promotions/pricing slice for the AWS Lambda nodejs20.x runtime; reads and writes the existing Sw* MySQL schema unchanged.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "tsc -p tsconfig.build.json",
    "bundle": "node esbuild.config.mjs",
    "build": "npm run typecheck && npm run bundle",
    "package": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"import('node:fs').then(fs=>['dist','build','coverage'].forEach(d=>fs.rmSync(d,{recursive:true,force:true})))\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "mysql2": "3.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
